<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GaragePro Bénin - SaaS Gestion Garage</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');body{font-family:'Inter',sans-serif}</style>
</head>
<body class="bg-slate-50">
<!-- PAYWALL -->
<div id="paywall" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.93);z-index:99999;align-items:center;justify-content:center;padding:20px">
<div style="background:#fff;border-radius:20px;padding:22px;max-width:380px;width:100%;text-align:center">
<h2 style="font-size:22px;font-weight:900">🚀 Essai terminé</h2>
<p style="font-size:13px;color:#475569;margin:8px 0">Ton atelier a généré <b>52 000 FCFA</b>. Continue!</p>
<div style="border:2px solid #f59e0b;border-radius:14px;padding:14px;margin:12px 0;background:#fffbeb">
<b>STARTER - Le plus choisi</b><br><span style="font-size:26px;font-weight:900">5 000 FCFA</span>/mois<br><small>100 clients • Factures MoMo • Relances WhatsApp</small><br><br>
<button onclick="payer(5000,'starter')" style="background:#f59e0b;width:100%;padding:12px;border:none;border-radius:8px;font-weight:800">Payer MoMo</button>
</div>
<div style="border:1px solid #ddd;border-radius:12px;padding:10px"><b>PRO 12 000 FCFA/mois</b><br><button onclick="payer(12000,'pro')" style="background:#0f172a;color:#fff;width:100%;padding:10px;border:none;border-radius:8px;margin-top:6px">Passer PRO</button></div>
<button onclick="document.getElementById('paywall').style.display='none'" style="margin-top:10px;border:none;background:none;color:#64748b;text-decoration:underline;font-size:12px">Fermer</button>
</div></div>

<header class="bg-slate-900 text-white px-4 py-3 flex justify-between items-center">
<div class="flex gap-2 items-center"><div class="bg-white text-slate-900 w-8 h-8 rounded-lg flex items-center justify-center font-black">G</div><div><div class="font-black text-sm">GaragePro</div><div class="text-[10px] text-amber-400 font-bold">ATELIER • Bénin</div></div></div>
<div class="text-right"><div class="text-[10px] text-slate-400">Connecté</div><div class="text-xs font-bold">Atelier AHOUNGAN</div></div>
</header>

<div class="p-4 max-w-6xl mx-auto space-y-3">
<div class="grid grid-cols-2 gap-3">
<div class="bg-white rounded-2xl p-4 shadow-sm"><div class="text-[11px] text-slate-500 font-bold">CA TOTAL</div><div class="text-2xl font-black mt-1">52 000 <span class="text-sm">FCFA</span></div></div>
<div class="bg-white rounded-2xl p-4 shadow-sm"><div class="text-[11px] text-slate-500 font-bold">BÉNÉFICE NET</div><div class="text-2xl font-black text-emerald-600 mt-1">27 000 <span class="text-sm">FCFA</span></div></div>
<div class="bg-white rounded-2xl p-4 shadow-sm"><div class="text-[11px] text-slate-500 font-bold">CLIENTS</div><div class="text-2xl font-black mt-1">18</div></div>
<div class="bg-white rounded-2xl p-4 shadow-sm"><div class="text-[11px] text-slate-500 font-bold">INTERVENTIONS</div><div class="text-2xl font-black mt-1">24</div></div>
</div>
<div class="bg-white rounded-2xl p-4 shadow-sm"><div class="font-bold text-sm mb-2">Top 5 Clients</div><div class="text-xs space-y-1"><div class="flex justify-between"><span>Adjovi Kokou</span><b>15 000</b></div><div class="flex justify-between"><span>Fatima Alassane</span><b>12 000</b></div><div class="flex justify-between"><span>Jean Koffi</span><b>9 500</b></div></div></div>
<div class="bg-white rounded-2xl p-4 shadow-sm"><div class="font-bold text-sm mb-2">Dernières interventions</div><div class="text-xs"><div class="flex justify-between py-1 border-b"><span>Vidange + Filtre - Adjovi</span><b>15 000 FCFA</b></div><div class="flex justify-between py-1 border-b"><span>Freinage - Fatima</span><b>22 000 FCFA</b></div><div class="flex justify-between py-1"><span>Diagnostic - Jean</span><b>5 000 FCFA</b></div></div></div>
</div>

<script>
function payer(m,f){let e=new Date();e.setDate(e.getDate()+30);localStorage.setItem('garage_abo',JSON.stringify({plan:f,prix:m,expiry:e.toISOString()}));alert('Paiement OK! '+f+' activé. Fedapay viendra ici.');document.getElementById('paywall').style.display='none';location.reload()}
(function(){let s=localStorage.getItem('garage_abo');if(!s){let e=new Date();e.setDate(e.getDate()+7);localStorage.setItem('garage_abo',JSON.stringify({plan:'essai',expiry:e.toISOString()}));s=localStorage.getItem('garage_abo')}let a=JSON.parse(s);let n=new Date();let x=new Date(a.expiry);let d=Math.ceil((x-n)/86400000);let b=document.createElement('div');b.style.cssText='position:fixed;top:58px;right:10px;background:#0f172a;color:#fff;padding:7px 12px;border-radius:20px;z-index:9998;font-size:12px;display:flex;align-items:center;box-shadow:0 4px 10px rgba(0,0,0,.3)';if(n>x){document.getElementById('paywall').style.display='flex';b.innerHTML='⛔ Essai fini <button onclick=document.getElementById("paywall").style.display="flex" style="background:#f59e0b;border:none;padding:3px 8px;border-radius:10px;margin-left:6px;font-weight:800">Payer</button>'}else{b.innerHTML=(a.plan==='essai'?'🎁 Essai '+d+'j':'✅ '+a.plan+' • '+d+'j')+' <button onclick=document.getElementById("paywall").style.display="flex" style="background:#f59e0b;border:none;padding:3px 8px;border-radius:10px;margin-left:6px;font-weight:800">Pro</button>'}document.body.appendChild(b)})();
</script>
</body>
</html>